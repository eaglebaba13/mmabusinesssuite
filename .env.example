# New Supabase configuration (browser-safe). Replace <PROJECT_ID> with your
# real NEW project reference. Keep this template committed; never commit live keys.
VITE_SUPABASE_PROJECT_ID=<PROJECT_ID>
VITE_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase authorization (existing application conventions).
SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only object storage; never prefix these names with VITE_.
MINIO_ENDPOINT=http://mma-minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>

